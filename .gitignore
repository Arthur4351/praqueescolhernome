# ==============================
# SOPHIA AI — .gitignore
# ==============================

# Segurança: nunca commitar credenciais
.env
*.env
*.env.local

# Config com segredos
config.json

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
*.egg-info/
dist/
build/
*.spec.bak

# Modelos LLM locais (grandes demais)
models/*.gguf
models/*.bin
models/*.ggml

# Output do sistema
dynamic_skills/
relatorios/
relatorios_n8n/
relatorios_sandbox/
fotos_teste_por_aba/
dummy_destino/

# Backups automáticos
*.bak

# PyInstaller
dist/
build/

# Logs e erros
erros_conhecidos.txt
ai_usage.json

# Bancos de dados locais / Memória local da IA
brain.json
long_term_memory.json

# Planilhas locais do usuário (binários de relatórios)
*.xlsx
*.xlsm
planilhas/
fotos_teste_por_aba/
dummy_destino/

# IDE e Build especificação
.vscode/
.idea/
*.suo
*.user
SOPHIA.spec

# Dados de cache / Metadados temporários de subagentes do Obsidian
.agent/.shared/
dynamic_skills/
relatorios/
relatorios_n8n/
relatorios_sandbox/
